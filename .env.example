# DACTIVOS | Configuracion de ejemplo (publica)
# Copia este archivo a .env.local e introduce las credenciales publicas
# de TU proyecto de Supabase. No publiques .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA_DE_SUPABASE
# Nunca declares SUPABASE_SERVICE_ROLE_KEY o secretos aqui.

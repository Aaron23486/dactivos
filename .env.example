# Public Supabase settings for the web app. Copy to .env.local, or let `npm run env:local` write it
# from the local Supabase started with `npm run db:up`. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put a secret or service_role key here: every NEXT_PUBLIC_ value reaches the browser.

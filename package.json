{
  "name": "dactivos",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/source/*.test.mjs\"",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "supabase start",
    "db:down": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "env:local": "node scripts/env-local.ts",
    "demo:setup": "node scripts/demo-setup.ts",
    "create-admin": "node scripts/users.ts create --role ADMIN",
    "users": "node scripts/users.ts",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.ts\"",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 \"tests/unit/*.test.mjs\" \"tests/source/*.test.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "shadcn": "4.23.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module",
  "description": "Asset tracking for handhelds and computers: deliveries, returns, maintenance and audit history",
  "license": "MIT"
}
